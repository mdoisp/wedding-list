# Variáveis de ambiente — copie para .env e preencha os valores

# ── Backend ──────────────────────────────────────────────────────────────────
# Conexão com o banco PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@db:5432/wedding_list

# Chave secreta para assinar os JWTs (use um valor aleatório seguro em produção)
SECRET_KEY=change-me-in-production

# Algoritmo JWT
ALGORITHM=HS256

# Expiração do access token em minutos
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Expiração do refresh token em dias
REFRESH_TOKEN_EXPIRE_DAYS=7

# Chave de API do Resend (https://resend.com)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Endereço de origem dos e-mails enviados pelo Resend
EMAIL_FROM=Wedding List <onboarding@resend.dev>

# Ambiente: development | test | production
ENVIRONMENT=development

# Origens permitidas para CORS (separadas por vírgula em produção, ex: https://seu-app.vercel.app)
ALLOWED_ORIGINS=*

# Nível de log: DEBUG | INFO | WARNING | ERROR (padrão: INFO)
LOG_LEVEL=INFO

# ── Frontend ─────────────────────────────────────────────────────────────────
# URL base do backend (sem barra final)
NEXT_PUBLIC_API_URL=http://localhost:8000
